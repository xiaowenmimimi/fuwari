---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import lxgwWenKaiScreenCssUrl from "lxgw-wenkai-screen-webfont/lxgwwenkaiscreen.css?url";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import WaveDivider from "../components/misc/WaveDivider.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import {
	getBannerFallbackSource,
	getRandomBannerConfig,
	pickBannerSource,
} from "../utils/banner-utils";
import { pathsEqual, url } from "../utils/url-utils";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	dynamicToc?: boolean;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	dynamicToc = false,
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";

const fallbackBannerSource = getBannerFallbackSource(siteConfig.banner.src);
const pickedFallbackBanner = pickBannerSource(fallbackBannerSource);
let bannerCreditText = siteConfig.banner.credit.text;
let bannerCreditUrl = siteConfig.banner.credit.url;
const fallbackBannerImage = pickedFallbackBanner.src;
// 如果横幅是一个数组，我们需要随机选择一个，并选择相应的信用文本和url
if (pickedFallbackBanner.index !== null) {
	const index = pickedFallbackBanner.index;
	if (Array.isArray(bannerCreditText)) {
		bannerCreditText = bannerCreditText[index];
	}
	if (Array.isArray(bannerCreditUrl)) {
		bannerCreditUrl = bannerCreditUrl[index];
	}
}

const bannerImage =
	banner && banner.trim().length > 0 ? banner : (fallbackBannerImage ?? "");
const hasBannerImage = bannerImage.length > 0;
const bannerText = bannerCreditText as string;
const bannerUrl = bannerCreditUrl as string;
const randomBannerConfig = getRandomBannerConfig(siteConfig.banner.src);
const randomBannerEnabled =
	siteConfig.banner.enable &&
	!!randomBannerConfig?.api &&
	!!randomBannerConfig.ossBase;
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
{isHomePage && <link slot="head" rel="stylesheet" href={lxgwWenKaiScreenCssUrl} />}
<div id="top-row" class="z-50 pointer-events-none relative h-[4.5rem] transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto fixed left-0 right-0 top-0 z-50 mx-auto max-w-[var(--page-width)] px-0 md:px-4 transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{siteConfig.banner.enable && hasBannerImage && <div
	id="banner-wrapper"
	class={`absolute z-10 w-full transition duration-700 overflow-hidden`}
	style={`top: calc(-1 * var(--banner-extend-vh, ${BANNER_HEIGHT_EXTEND}vh))`}
	data-random-banner-enabled={randomBannerEnabled ? "true" : "false"}
	data-random-banner-api={randomBannerConfig?.api}
	data-random-banner-oss-base={randomBannerConfig?.ossBase}
>
	<ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={bannerImage} position={siteConfig.banner.position}
    >
    </ImageWrapper>
	<WaveDivider class="z-20"></WaveDivider>
    <div class="hero-content absolute inset-0 flex flex-col items-center justify-center z-20 text-white pointer-events-none px-4">
        <div class="text-4xl md:text-6xl font-bold tracking-widest mb-4 md:mb-6 drop-shadow-lg text-center" style="font-family: 'LXGW WenKai Screen', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Serif SC', serif;">{siteConfig.title}</div>
        <div class="text-xl md:text-2xl opacity-90 tracking-wide drop-shadow-md text-center px-4 py-2 rounded-lg font-medium" style="font-family: 'LXGW WenKai Screen', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Serif SC', serif;">
            <span id="subtitle-typewriter"></span>
        </div>
    </div>
    <div class="absolute bottom-8 w-full flex justify-center z-20 pointer-events-none">
        <button id="home-scroll-button" type="button" aria-label="Scroll to content" class="hero-content text-white pointer-events-auto cursor-pointer border-0 bg-transparent p-0">
            <Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-4xl md:text-6xl drop-shadow-md animate-bounce"></Icon>
        </button>
    </div>
	<!-- Banner image credit -->
	{hasBannerCredit && <a href={bannerUrl} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
						   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
						   "px-3 left-4 right-auto bottom-16 md:left-auto md:right-4 md:bottom-4 bg-black/60 hover:bg-black/70 h-9 z-30", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
	>
		<Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
		<div class="text-white/75 text-xs">{bannerText}</div>
		<Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
			{"group-hover:opacity-100": hasBannerLink}]}
			  name="fa6-solid:arrow-up-right-from-square">
		</Icon>
	</a>}
</div>}

<style is:global>
	.enable-banner:not(.is-post):not(.is-bangumi) #banner-wrapper .wave-divider {
		display: none;
	}
	.enable-banner.is-post #banner-wrapper .wave-divider {
		opacity: 0;
		transform: translateY(8px);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}
	html.post-wave-divider-ready .enable-banner.is-post #banner-wrapper .wave-divider {
		opacity: 1;
		transform: translateY(0);
	}
	@media (max-width: 767px) {
		.enable-banner #banner-wrapper .wave-divider {
			display: none;
		}
	}
    .hero-content {
        opacity: 0;
        transition: opacity 0.7s ease-in-out;
        transform: translateY(20px);
    }
    .is-home .hero-content {
        opacity: 1;
        transform: translateY(0);
    }
    #subtitle-typewriter::after {
        content: "|";
        animation: blink 1s step-end infinite;
    }
    #subtitle-typewriter.typing-done::after {
        display: none;
    }
    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }
</style>

<script is:inline define:vars={{ subtitle: siteConfig.homeSubtitle }}>
    function scrollHomeMainGridIntoView() {
        const target = document.getElementById("home-post-list-anchor") ?? document.getElementById("main-grid");
        if (!target) return;

        const navbar = document.getElementById("navbar-wrapper");
        const navbarHeight = navbar?.getBoundingClientRect().height ?? 0;
        const extraGap = 12;
        const targetTop = target.getBoundingClientRect().top + window.scrollY - navbarHeight - extraGap;

        window.scrollTo({
            top: Math.max(0, targetTop),
            behavior: "smooth",
        });
    }

    function bindHomeScrollButton() {
        const scrollButton = document.getElementById("home-scroll-button");
        if (!scrollButton) return;
        scrollButton.onclick = scrollHomeMainGridIntoView;
    }

    function shouldRunHomeTypewriter() {
        return document.body.classList.contains("is-home") || window.location.pathname === "/";
    }

    function typeWriter(text, i, fnCallback) {
        if (!shouldRunHomeTypewriter()) return;
        const subtitleElement = document.getElementById("subtitle-typewriter");
        if (!subtitleElement) return;
        if (i < (text.length)) {
            subtitleElement.innerHTML = text.substring(0, i+1) +'<span aria-hidden="true"></span>';

            setTimeout(function() {
                typeWriter(text, i + 1, fnCallback)
            }, 100);
        } else if (typeof fnCallback == 'function') {
            setTimeout(fnCallback, 700);
        }
    }

    function startTypewriter() {
        if (!shouldRunHomeTypewriter()) return;
        const subtitleElement = document.getElementById("subtitle-typewriter");
        if (!subtitleElement) return;
        
        subtitleElement.classList.remove("typing-done");
        subtitleElement.innerHTML = "";
        setTimeout(function() {
            typeWriter(subtitle, 0, function(){
                subtitleElement.classList.add("typing-done");
            });
        }, 500); // delay before starting
    }

    function startPostWaveDivider() {
        const root = document.documentElement;
        root.classList.remove("post-wave-divider-ready");
        if (!document.body.classList.contains("is-post")) return;
        setTimeout(function() {
            if (document.body.classList.contains("is-post")) {
                root.classList.add("post-wave-divider-ready");
            }
        }, 120);
    }

    document.addEventListener('astro:page-load', startTypewriter);
    document.addEventListener('astro:page-load', startPostWaveDivider);
    document.addEventListener('astro:page-load', bindHomeScrollButton);
    // Initial load
    if (document.readyState === 'complete') {
        startTypewriter();
        startPostWaveDivider();
        bindHomeScrollButton();
    } else {
        document.addEventListener('DOMContentLoaded', startTypewriter);
        document.addEventListener('DOMContentLoaded', startPostWaveDivider);
        document.addEventListener('DOMContentLoaded', bindHomeScrollButton);
    }
</script>

<script>
	import { toRandomBannerImageUrl } from "../utils/banner-utils";

	const randomBannerState = window as Window & {
		__fuwariRandomBannerLoaded?: boolean;
	};
	const RANDOM_BANNER_TIMEOUT_MS = 2500;
	const RANDOM_BANNER_IMAGE_TIMEOUT_MS = 5000;

	function preloadImage(src: string) {
		return new Promise<void>((resolve, reject) => {
			const image = new Image();
			const timeout = window.setTimeout(() => {
				image.onload = null;
				image.onerror = null;
				reject(new Error("Random banner image load timed out"));
			}, RANDOM_BANNER_IMAGE_TIMEOUT_MS);

			image.referrerPolicy = "no-referrer";
			image.decoding = "async";
			image.onload = () => {
				window.clearTimeout(timeout);
				resolve();
			};
			image.onerror = () => {
				window.clearTimeout(timeout);
				reject(new Error("Random banner image failed to load"));
			};
			image.src = src;
		});
	}

	function replaceBannerImage(banner: HTMLElement, imageUrl: string) {
		const image = banner.querySelector("img");
		if (!image) return;

		if (image.currentSrc === imageUrl || image.src === imageUrl) return;

		for (const source of banner.querySelectorAll("source")) {
			source.removeAttribute("srcset");
		}
		image.removeAttribute("srcset");
		image.removeAttribute("sizes");
		image.referrerPolicy = "no-referrer";
		image.decoding = "async";
		image.src = imageUrl;
	}

	async function loadRandomBanner() {
		if (randomBannerState.__fuwariRandomBannerLoaded) return;

		const wrapper = document.getElementById("banner-wrapper");
		const banner = document.getElementById("banner");
		if (!wrapper || !banner) return;
		if (wrapper.dataset.randomBannerEnabled !== "true") return;

		const api = wrapper.dataset.randomBannerApi;
		const ossBase = wrapper.dataset.randomBannerOssBase;
		if (!api || !ossBase) return;

		const controller = new AbortController();
		const timeout = window.setTimeout(
			() => controller.abort(),
			RANDOM_BANNER_TIMEOUT_MS,
		);

		try {
			const response = await fetch(api, {
				signal: controller.signal,
				cache: "no-store",
				referrerPolicy: "no-referrer",
			});
			if (!response.ok) return;

			const data = (await response.json()) as unknown;
			const imageUrl = toRandomBannerImageUrl(data, ossBase);
			if (!imageUrl) return;

			await preloadImage(imageUrl);
			replaceBannerImage(banner, imageUrl);
			randomBannerState.__fuwariRandomBannerLoaded = true;
		} catch {
			// Keep the fallback banner when the random API or image request fails.
		} finally {
			window.clearTimeout(timeout);
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", loadRandomBanner, { once: true });
	} else {
		loadRandomBanner();
	}
</script>

<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none" style={`top: var(--main-panel-top, ${mainPanelTop})`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-none">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]
    mx-auto gap-4 px-0 md:px-4 pointer-events-auto"
        >
            <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" headings={headings}></SideBar>

            <main id="swup-container" class="transition-swup-fade col-span-2 lg:col-span-1 overflow-hidden">
                <div id="content-wrapper" class="onload-animation">
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                    <div class="footer col-span-2 onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <div class="pointer-events-auto">
            <BackToTop></BackToTop>
        </div>
    </div>
</div>

<!-- The things that should be under the banner, only the TOC for now -->
<div class="absolute w-full z-0 hidden 2xl:block">
    <div class="relative max-w-[var(--page-width)] mx-auto">
        <!-- TOC component -->
        {siteConfig.toc.enable && <div id="toc-wrapper" class:list={["hidden lg:block transition absolute top-0 -right-[var(--toc-width)] w-[var(--toc-width)] items-center", {"toc-empty": headings.length === 0}]}
        >
            <div id="toc-inner-wrapper" class="fixed w-[var(--toc-width)] overflow-y-scroll overflow-x-hidden hide-scrollbar">
                <div id="toc" class="w-full h-full transition-swup-fade ">
                    <div class="h-8 w-full"></div>
                    <TOC headings={headings} dynamic={dynamicToc}></TOC>
                    <div class="h-8 w-full"></div>
                </div>
            </div>
        </div>}

        <!-- #toc needs to exist for Swup to work normally -->
        {!siteConfig.toc.enable && <div id="toc"></div>}
    </div>
</div>
</Layout>
