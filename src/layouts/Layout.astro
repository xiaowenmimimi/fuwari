/* Load settings when entering the site */
init();

let lastTrackedPath: string | null = null;
let pendingTrackPath: string | null = null;
let nextUmamiUrl: string | null = null;
const resetScrollPosition = () => {
	window.scrollTo(0, 0);
	document.documentElement.scrollTop = 0;
	document.body.scrollTop = 0;
};
function trackUmamiPageview(tries = 0, urlOverride: string | null = null) {
	const desiredUrl = urlOverride ?? window.location.href;
	const currentPath = (() => {
		try {
			const u = new URL(desiredUrl, window.location.origin);
			return `${u.pathname}${u.search}`;
		} catch {
			return `${window.location.pathname}${window.location.search}`;
		}
	})();
	if (lastTrackedPath === currentPath) return;

	const maxTries = 25;
	const umami = (window as unknown as { umami?: { track?: (...args: unknown[]) => void } }).umami;
	if (umami?.track) {
		umami.track((props: unknown) => ({ ...(props as Record<string, unknown>), url: desiredUrl }));
		lastTrackedPath = currentPath;
		pendingTrackPath = null;
		return;
	}

	if (tries >= maxTries) {
		if (pendingTrackPath === currentPath) pendingTrackPath = null;
		return;
	}

	if (pendingTrackPath === currentPath) return;
	pendingTrackPath = currentPath;
	window.setTimeout(() => trackUmamiPageview(tries + 1, urlOverride), 200);
}
trackUmamiPageview();

const setup = () => {
	window.history.scrollRestoration = 'manual';
	// TODO: temp solution to change the height of the banner
/*
	window.swup.hooks.on('animation:out:start', () => {
		const path = window.location.pathname
		const body = document.querySelector('body')
		if (path[path.length - 1] === '/' && !body.classList.contains('is-home')) {
			body.classList.add('is-home')
		} else if (path[path.length - 1] !== '/' && body.classList.contains('is-home')) {
			body.classList.remove('is-home')
		}
	})
*/
	window.swup.hooks.on('link:click', () => {
		// Remove the delay for the first time page load
		document.documentElement.style.setProperty('--content-delay', '0ms')

	})
	window.swup.hooks.on('content:replace', (visit: any) => {
		if (visit.scroll.reset && !visit.history.popstate) {
			resetScrollPosition();
		}
		initCustomScrollbar();
	})
	window.swup.hooks.on('visit:start', (visit: {to: {url: string}, scroll?: {reset?: boolean}, history?: {popstate?: boolean}}) => {
		nextUmamiUrl = visit.to.url;
		const toHash = (() => {
			try {
				return new URL(visit.to.url, window.location.origin).hash;
			} catch {
				return '';
			}
		})();
		if (visit.scroll?.reset !== false && !visit.history?.popstate && !toHash) {
			resetScrollPosition();
		}
		// change banner height immediately when a link is clicked
		const bodyElement = document.querySelector('body')
		if (pathsEqual(visit.to.url, url('/'))) {
			bodyElement!.classList.add('is-home');
		} else {
			bodyElement!.classList.remove('is-home');
		}
		const toPathname = (() => {
			try {
				return new URL(visit.to.url, window.location.origin).pathname;
			} catch {
				return visit.to.url;
			}
		})();
		if (toPathname.startsWith(url('/posts/'))) {
			bodyElement!.classList.add('is-post');
		} else {
			bodyElement!.classList.remove('is-post');
		}
		if (pathsEqual(visit.to.url, url('/bangumi'))) {
			bodyElement!.classList.add('is-bangumi');
		} else {
			bodyElement!.classList.remove('is-bangumi');
		}

		// increase the page height during page transition to prevent the scrolling animation from jumping
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}

		// Hide the TOC while scrolling back to top
		let toc = document.getElementById('toc-wrapper');
		if (toc) {
			toc.classList.add('toc-not-ready')
		}
	});

	window.swup.hooks.on('page:view', () => {
		// hide the temp high element when the transition is done
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.add('hidden')
		}
		const u = nextUmamiUrl;
		nextUmamiUrl = null;
		trackUmamiPageview(0, u)
		requestAnimationFrame(() => {
			const toc = document.getElementById('toc-wrapper');
			if (toc) {
				toc.classList.remove('toc-not-ready')
			}
			scrollFunction();
		});
	});

	// Disable smooth scrolling between pages so it doesn't jump to the middle then scroll up
	const scrollPlugin = window.swup.findPlugin?.('SwupScrollPlugin') || window.swup.plugins?.find((p: any) => p.name === 'SwupScrollPlugin');
	if (scrollPlugin) {
		scrollPlugin.options.animateScroll = {
			betweenPages: false,
			samePageWithHash: false,
			samePage: false
		};
	}
}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

let backToTopBtn = document.getElementById('back-to-top-btn');
let toc = document.getElementById('toc-wrapper');
let tocInner = document.getElementById('toc-inner-wrapper');
function scrollFunction() {
	let bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100)

    // 在 Swup 内容替换的情况下更新元素引用
    backToTopBtn = document.getElementById('back-to-top-btn');
    toc = document.getElementById('toc-wrapper');
    tocInner = document.getElementById('toc-inner-wrapper');

	if (backToTopBtn) {
		if (document.body.scrollTop > bannerHeight || document.documentElement.scrollTop > bannerHeight) {
			backToTopBtn.classList.remove('hide')
		} else {
			backToTopBtn.classList.add('hide')
		}
	}

	if (bannerEnabled && toc && tocInner) {
		let scrollTop = document.body.scrollTop || document.documentElement.scrollTop;
		let viewportAdaptiveOffset = 88 + Math.max(0, (window.innerHeight - 1080) * 0.2);
		let targetTop = Math.max(56, bannerHeight - scrollTop + viewportAdaptiveOffset);
		tocInner.style.top = `${targetTop}px`;
		toc.classList.remove('toc-hide');
	}
}
window.onscroll = scrollFunction

window.onresize = () => {
	// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
	let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
	offset = offset - offset % 4;
	document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
}

// 初始化滚动位置
scrollFunction();

</script>

<script>
import PhotoSwipeLightbox from "photoswipe/lightbox"
import "photoswipe/style.css"

let lightbox: PhotoSwipeLightbox | undefined
let pswp = import("photoswipe")
let documentPhotoSwipeHooksBound = false
let swupPhotoSwipeHooksBound = false

function createPhotoSwipe() {
	lightbox = new PhotoSwipeLightbox({
		gallery: ".custom-md img, #post-cover img",
		pswpModule: () => pswp,
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: false,
		arrowNext: false,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
	})

	lightbox.addFilter("domItemData", (itemData, element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src

			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)

			itemData.msrc = element.src
		}

		return itemData
	})

	lightbox.init()
}

function recreatePhotoSwipe() {
	lightbox?.destroy?.()
	createPhotoSwipe()
}

function bindDocumentPhotoSwipeHooks() {
	if (documentPhotoSwipeHooksBound) return
	documentPhotoSwipeHooksBound = true

	document.addEventListener("encrypted-post-unlocked", () => {
		requestAnimationFrame(recreatePhotoSwipe)
	})
	document.addEventListener("astro:page-load", () => {
		requestAnimationFrame(() => {
			recreatePhotoSwipe()
			bindSwupPhotoSwipeHooks()
		})
	})
}

function bindSwupPhotoSwipeHooks() {
	if (swupPhotoSwipeHooksBound || !window.swup?.hooks) return
	swupPhotoSwipeHooksBound = true

	window.swup.hooks.on(
		"content:replace",
		() => {
			lightbox?.destroy?.()
			lightbox = undefined
		},
		{ before: true },
	)
}

function setup() {
	if (!lightbox) {
		createPhotoSwipe()
	}
	bindDocumentPhotoSwipeHooks()
	bindSwupPhotoSwipeHooks()
}

setup()
</script>
