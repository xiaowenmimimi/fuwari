---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";

import ConfigCarrier from "@components/ConfigCarrier.astro";
import { profileConfig, siteConfig } from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import {
	getBannerFallbackSource,
	pickBannerSource,
} from "../utils/banner-utils";
import { pathsEqual, url } from "../utils/url-utils";
import "katex/dist/katex.css";
import ExternalLinkModal from "../components/misc/ExternalLinkModal.astro";
import UmamiAnalytics from "../components/misc/UmamiAnalytics.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

let { title, banner, description, lang, setOGTypeArticle } = Astro.props;

const normalizePath = (path: string) =>
	path
		.replace(/^https?:\/\/[^/]+/i, "")
		.split(/[?#]/)[0]
		.replace(/^\/|\/$/g, "")
		.toLowerCase();
const normalizedBase = normalizePath(url("/"));
const isHomeListPagePath = (path: string) => {
	const normalizedPath = normalizePath(path);
	if (normalizedPath === normalizedBase) return true;
	const relativePath =
		normalizedBase && normalizedPath.startsWith(`${normalizedBase}/`)
			? normalizedPath.slice(normalizedBase.length + 1)
			: normalizedPath;
	return /^\d+$/.test(relativePath);
};

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = isHomeListPagePath(Astro.url.pathname);
const isPostPage = Astro.url.pathname.startsWith(url("/posts/"));
const isBangumiPage = pathsEqual(Astro.url.pathname, url("/bangumi"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHueCandidates = siteConfig.themeColor.presets.map(
	(preset) => preset.hue,
);
const configHue = configHueCandidates[0] ?? 250;
// TODO don't use post cover as banner for now
// banner = siteConfig.banner.src;
const fallbackBannerSource = getBannerFallbackSource(siteConfig.banner.src);
const pickedFallbackBanner = pickBannerSource(fallbackBannerSource);
if (pickedFallbackBanner.src) {
	banner = pickedFallbackBanner.src;
} else if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = undefined;
}

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px]"
	  data-overlayscrollbars-initialize
>
	<head>
		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle}>
		<meta name="author" content={profileConfig.name}>
        
        <UmamiAnalytics />

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description || pageTitle}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description || pageTitle}>

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHueCandidates}}>
			// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			// 从本地存储加载色调，每次刷新时随机选择一个色调
			const hueCandidates = Array.isArray(configHueCandidates) ? configHueCandidates : [configHueCandidates];
			const normalizedHueCandidates = hueCandidates.length > 0 ? hueCandidates : [250];
			const storedHue = localStorage.getItem('hue');
			const existingRandomHue = document.documentElement.dataset.randomHue;
			const lastRandomHue = sessionStorage.getItem('lastRandomHue');
			const availableHueCandidates = normalizedHueCandidates.length > 1
				? normalizedHueCandidates.filter((candidate) => String(candidate) !== lastRandomHue)
				: normalizedHueCandidates;
			const randomHueCandidates = availableHueCandidates.length > 0 ? availableHueCandidates : normalizedHueCandidates;
			const randomHue = randomHueCandidates[Math.floor(Math.random() * randomHueCandidates.length)];
			if (!storedHue && !existingRandomHue) {
				document.documentElement.dataset.randomHue = randomHue;
				sessionStorage.setItem('lastRandomHue', String(randomHue));
			}
			const hue = storedHue || existingRandomHue || randomHue;
			document.documentElement.style.setProperty('--hue', hue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->

		<script
			defer
			src="https://analytics.xhwen.cn/script.js"
			data-website-id="1622d120-0aaa-4728-804b-0a719cdeef93"
			data-swup-ignore-script
			data-auto-track="false"
		></script>

		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>

	</head>
	<body class=" min-h-screen " class:list={[{"is-home": isHomePage, "is-post": isPostPage, "is-bangumi": isBangumiPage, "enable-banner": enableBanner}]}
		  data-overlayscrollbars-initialize
	>
		<ConfigCarrier></ConfigCarrier>
		<slot />

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
		<ExternalLinkModal />
	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
@tailwind components;
@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		transform: translateY(calc(var(--banner-height-extend) + 5rem + var(--home-main-grid-spacer-height, 0px)));
		transition-property: opacity;
	}
	.enable-banner.is-home #top-row {
		height: 0;
		@apply transition-all duration-300
	}
	.enable-banner:not(.is-home) #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4rem)] md:h-[calc(var(--banner-height-home)_-_5.5rem)] transition-all duration-300
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(5.5rem_-_var(--banner-height-extend)_-_10.5rem)]
	}
}
</style>

<style is:global>
#toc-inner-wrapper {
	top: 5.5rem;
	bottom: 14rem;
}
.enable-banner #toc-inner-wrapper {
	top: calc(var(--banner-height) + 5.5rem);
	bottom: 14rem;
}
.enable-banner.is-home #toc-inner-wrapper {
	top: calc(var(--banner-height-home) + 5.5rem);
	bottom: 14rem;
}
</style>

<script>
	import { setupCodeBlockCollapse } from "../scripts/codeblock-collapse";
	import { setupLayoutCore } from "../scripts/layout-core";
	import { setupPhotoSwipeGallery } from "../scripts/photoswipe-gallery";

	setupLayoutCore();
	setupPhotoSwipeGallery();
	setupCodeBlockCollapse();
</script>
