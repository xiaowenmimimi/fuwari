---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="navbar-shell relative z-50 max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto">
    <div id="navbar-bg" class:list={[
        className,
        "!overflow-visible h-full w-full grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center px-4"]}>
        <a href={url('/')} class="btn-plain scale-animation justify-self-start min-w-0 max-w-full rounded-lg h-[3.25rem] px-5 font-bold active:scale-95">
            <div class="flex min-w-0 flex-row text-[var(--primary)] items-center text-md">
                <Icon name="material-symbols:home-outline-rounded" class="shrink-0 text-[1.75rem] mb-1 mr-2" />
                <span class="truncate">{siteConfig.title}</span>
            </div>
        </a>
        <div class="hidden md:flex justify-self-center max-w-[min(52vw,calc(var(--page-width)_-_24rem))] overflow-x-auto hide-scrollbar">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                          class="btn-plain scale-animation shrink-0 rounded-lg h-11 font-bold px-5 active:scale-95"
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="flex justify-self-end justify-end min-w-[11rem] md:min-w-[15.5rem]">
            <!--<SearchPanel client:load>-->
            <Search client:only="svelte"></Search>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch" type="button">
                        <Icon name="material-symbols:palette-outline" class="theme-trigger-icon text-[1.25rem]"></Icon>
                    </button>
            )}
            <LightDarkSwitch client:load></LightDarkSwitch>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings client:only="svelte"></DisplaySettings>
    </div>
</div>

<script>
function switchTheme() {
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
    } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
    }
}

function getThemePresets() {
    const configCarrier = document.getElementById("config-carrier");
    const rawPresets = configCarrier?.dataset.themePresets;
    if (!rawPresets) return [];
    try {
        const parsed = JSON.parse(rawPresets);
        return Array.isArray(parsed) ? parsed : [];
    } catch {
        return [];
    }
}

function getCurrentHue() {
    const storedHue = localStorage.getItem("hue");
    if (storedHue) {
        return Number.parseInt(storedHue, 10);
    }
    const randomHue = document.documentElement.dataset.randomHue;
    if (randomHue) {
        return Number.parseInt(randomHue, 10);
    }
    const configCarrier = document.getElementById("config-carrier");
    return Number.parseInt(configCarrier?.dataset.hue || "250", 10);
}

function getThemeName(hue: number) {
    const normalizedHue = Number.isFinite(hue)
        ? ((Math.round(hue) % 361) + 361) % 361
        : 250;
    const preset = getThemePresets().find((item) => Number(item?.hue) === normalizedHue);
    return typeof preset?.name === "string" && preset.name.trim().length > 0
        ? preset.name.trim()
        : `Hue ${normalizedHue}`;
}

function updateThemeTrigger(detail?: { hue?: number; name?: string }) {
    const settingBtn = document.getElementById("display-settings-switch");
    if (!settingBtn) return;
    const nextHue = detail?.hue;
    const hue = typeof nextHue === "number" ? nextHue : getCurrentHue();
    const name = typeof detail?.name === "string" && detail.name.trim().length > 0
        ? detail.name.trim()
        : getThemeName(hue);
    settingBtn.setAttribute("title", `当前主题：${name}`);
}

function loadButtonScript() {
    let switchBtn = document.getElementById("scheme-switch");
    if (switchBtn) {
        switchBtn.onclick = function () {
            switchTheme()
        };
    }

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    updateThemeTrigger();
}

loadButtonScript();
document.addEventListener("theme-hue-change", (event) => {
    const customEvent = event as CustomEvent<{ hue?: number; name?: string }>;
    updateThemeTrigger(customEvent.detail);
});

document.addEventListener('astro:after-swap', () => {
    loadButtonScript();
}, { once: false });

</script>

<script is:inline>

function setTransparentNav() {
    const navbar = document.getElementById('navbar');
	const isTop = document.body.scrollTop === 0 && document.documentElement.scrollTop === 0;
	navbar.classList.toggle('navbar-glass', !isTop);
}

document.addEventListener('scroll', setTransparentNav);
document.addEventListener('astro:after-swap', setTransparentNav); // Ensure state is correct after navigation
setTransparentNav(); // Initial check

</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    if (window.pagefind && typeof window.pagefind.search === 'function') {
        document.dispatchEvent(new CustomEvent('pagefindready'));
        return window.pagefind;
    }
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (!window.ensurePagefindLoaded) {
    let loadingPromise = null;
    window.ensurePagefindLoaded = () => {
        if (!loadingPromise) {
            loadingPromise = loadPagefind();
        }
        return loadingPromise;
    };
}
</script>}
