---
import { getBangumiFilters, getBangumiItemStatus } from "@utils/bangumi-data";
import type { UserSubjectCollection } from "@/types/bangumi";
import Card from "./Card.astro";
import FilterControls from "./FilterControls.astro";
import Pagination from "./Pagination.astro";

interface Props {
	sectionId: string;
	items: UserSubjectCollection[];
	isActive: boolean;
	initialItems?: UserSubjectCollection[];
	itemsPerPage?: number;
	totalItems?: number;
}

const {
	sectionId,
	items,
	isActive,
	initialItems,
	itemsPerPage = 12,
	totalItems = items.length,
} = Astro.props;

const filters = getBangumiFilters(items, sectionId);
const renderedItems = initialItems ?? items.slice(0, itemsPerPage);
---

<div
  class:list={["bangumi-section", { "hidden": !isActive }]}
  data-section={sectionId}
  data-total-items={totalItems}
  data-items-per-page={itemsPerPage}
  data-current-page="1"
  data-current-filter="all"
>
  {totalItems > 0 ? (
    <>
      <FilterControls
        filters={filters}
        activeFilter="all"
        sectionId={sectionId}
      />

      <div
        class="grid grid-cols-3 md:grid-cols-4 gap-3 sm:gap-6 md:gap-8"
        data-bangumi-grid={sectionId}
        data-loaded={renderedItems.length > 0 ? "true" : "false"}
      >
        {renderedItems.map((item) => (
          <div
            class="bangumi-item"
            data-item-section={sectionId}
            data-item-status={getBangumiItemStatus(item)}
          >
            <Card item={item} />
          </div>
        ))}
      </div>

      <div class="hidden text-center py-12" data-bangumi-empty={sectionId}>
        <h3 class="text-xl font-medium text-gray-600 dark:text-gray-400 mb-2">暂无数据</h3>
        <p class="text-gray-500 dark:text-gray-500">该筛选下还没有任何条目</p>
      </div>

      <Pagination
        totalItems={totalItems}
        itemsPerPage={itemsPerPage}
        currentPage={1}
        sectionId={sectionId}
      />
    </>
  ) : (
    <div class="text-center py-12">
      <h3 class="text-xl font-medium text-gray-600 dark:text-gray-400 mb-2">暂无数据</h3>
      <p class="text-gray-500 dark:text-gray-500">该分类下还没有任何条目</p>
    </div>
  )}
</div>

<style is:global>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .fade-in-up {
    animation: fadeInUp 0.4s ease-out forwards;
  }
</style>
