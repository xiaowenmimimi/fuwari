---

import { siteConfig } from "../config";

const presets = siteConfig.themeColor.presets;
const hueCandidates = presets.map((preset) => preset.hue);
const hue = hueCandidates[0] ?? 250;
---

<div
	id="config-carrier"
	data-hue={hue}
	data-hue-candidates={hueCandidates.join(",")}
	data-theme-presets={JSON.stringify(presets)}
>
</div>
