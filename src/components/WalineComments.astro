---
import { Icon } from "astro-icon/components";
import "@waline/client/waline.css";
import "../styles/waline-comments.css";

interface Props {
	serverURL: string;
	lang?: string;
	login?: string;
	dark?: string;
	pageview?: boolean;
	imageUploadEndpoint?: string;
	imageUploadToken?: string;
	imageUploadMaxSizeMB?: number;
}

const {
	serverURL,
	lang,
	login,
	dark = "html.dark",
	pageview = false,
	imageUploadEndpoint,
	imageUploadToken,
	imageUploadMaxSizeMB,
} = Astro.props;
---
<section class="comment-section card-base !overflow-visible z-10 relative w-full mb-4 px-4 py-5 sm:px-6 sm:py-6" aria-labelledby="comments-title">
	<div class="comment-section__header mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
		<div class="flex items-start gap-3">
			<div class="comment-section__icon mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl">
				<Icon name="material-symbols:forum-rounded" class="text-[1.35rem]" />
			</div>
			<div>
				<h2 id="comments-title" class="comment-section__title m-0 text-lg font-bold leading-tight text-neutral-900 transition dark:text-neutral-100">
					评论
				</h2>
				<p class="comment-section__description mt-1 text-sm leading-6">
					文字让我们短暂相逢。
				</p>
			</div>
		</div>
	</div>
	<div
		id="waline"
		data-server-url={serverURL}
		data-lang={lang}
		data-login={login}
		data-dark={dark}
		data-pageview={pageview ? "true" : "false"}
		data-image-upload-endpoint={imageUploadEndpoint}
		data-image-upload-token={imageUploadToken}
		data-image-upload-max-size-mb={imageUploadMaxSizeMB}
	>
		<div class="waline-placeholder" aria-live="polite">
			<div class="waline-placeholder__avatar" aria-hidden="true"></div>
			<div class="waline-placeholder__content">
				<div class="waline-placeholder__line waline-placeholder__line--short" aria-hidden="true"></div>
				<div class="waline-placeholder__line" aria-hidden="true"></div>
				<div class="waline-placeholder__line waline-placeholder__line--medium" aria-hidden="true"></div>
				<div class="waline-placeholder__text">评论加载中…</div>
			</div>
		</div>
	</div>
</section>
<script>
	import "../scripts/waline-comments";
</script>

