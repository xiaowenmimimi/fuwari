<script>
declare global {
	interface Window {
		initMermaidDiagrams?: (root?: ParentNode) => Promise<void>;
	}
}

(() => {
	if (window.initMermaidDiagrams) return;

	let mermaidModulePromise: Promise<typeof import("mermaid")> | null = null;
	let currentMermaidTheme: "light" | "dark" | null = null;
	let themeRerenderFrame = 0;

	const getThemeMode = () =>
		document.documentElement.classList.contains("dark") ? "dark" : "light";

	const getMermaidConfig = (mode: "light" | "dark") => ({
		startOnLoad: false,
		theme: "base" as const,
		themeVariables:
			mode === "dark"
				? {
						background: "transparent",
						primaryColor: "#1f3347",
						primaryTextColor: "#d8e5f4",
						primaryBorderColor: "#5f85ad",
						secondaryColor: "#193d38",
						tertiaryColor: "#2b2f3a",
						lineColor: "#8aa1ba",
						textColor: "#d8e5f4",
						mainBkg: "#1f3347",
						secondBkg: "#193d38",
						tertiaryTextColor: "#d8e5f4",
						clusterBkg: "#1a2430",
						clusterBorder: "#50677f",
						edgeLabelBackground: "#18212c",
						noteBkgColor: "#2b2f3a",
						noteTextColor: "#d8e5f4",
						noteBorderColor: "#5f85ad",
						fontFamily: "inherit",
					}
				: {
						background: "transparent",
						primaryColor: "#eaf3ff",
						primaryTextColor: "#223044",
						primaryBorderColor: "#86acd8",
						secondaryColor: "#e8f7f3",
						tertiaryColor: "#f3f5f8",
						lineColor: "#61748b",
						textColor: "#223044",
						mainBkg: "#eaf3ff",
						secondBkg: "#e8f7f3",
						tertiaryTextColor: "#223044",
						clusterBkg: "#f6f8fb",
						clusterBorder: "#c5d1df",
						edgeLabelBackground: "#ffffff",
						noteBkgColor: "#fff7dd",
						noteTextColor: "#3a2f17",
						noteBorderColor: "#d2b25f",
						fontFamily: "inherit",
					},
	});

	const applyMermaidTheme = (mermaid: typeof import("mermaid").default) => {
		const mode = getThemeMode();
		if (currentMermaidTheme === mode) return;

		mermaid.initialize(getMermaidConfig(mode));
		currentMermaidTheme = mode;
	};

	const getMermaid = async () => {
		mermaidModulePromise ??= import("mermaid").then((module) => {
			applyMermaidTheme(module.default);
			return module;
		});

		return mermaidModulePromise;
	};

	const schedule = (callback: () => void) => {
		const requestIdleCallback = (
			window as Window & {
				requestIdleCallback?: (
					callback: () => void,
					options?: { timeout: number },
				) => number;
			}
		).requestIdleCallback;

		if (requestIdleCallback) {
			requestIdleCallback(callback, { timeout: 1500 });
			return;
		}
		window.setTimeout(callback, 0);
	};

	const showDiagramError = (diagram: HTMLElement, error: unknown) => {
		console.error("[MERMAID] Failed to render diagram.", error);

		diagram.querySelector(".mermaid-render")?.remove();

		const placeholder =
			diagram.querySelector<HTMLElement>(".mermaid-placeholder") ??
			document.createElement("div");
		placeholder.className = "mermaid-placeholder";
		placeholder.textContent = "图表渲染失败，请检查 Mermaid 语法。";

		if (!placeholder.parentElement) {
			diagram.prepend(placeholder);
		}

		const source = diagram.querySelector<HTMLElement>(".mermaid-source");
		source?.removeAttribute("aria-hidden");

		diagram.dataset.mermaidPending = "false";
		diagram.dataset.mermaidError = "true";
	};

	const resetRenderedDiagram = (diagram: HTMLElement) => {
		diagram.querySelector(".mermaid-render")?.remove();

		if (!diagram.querySelector(".mermaid-placeholder")) {
			const placeholder = document.createElement("div");
			placeholder.className = "mermaid-placeholder";
			placeholder.textContent = "图表加载中...";
			diagram.prepend(placeholder);
		}

		diagram.dataset.mermaidPending = "true";
		delete diagram.dataset.mermaidLoaded;
		delete diagram.dataset.mermaidError;
	};

	const rerenderLoadedDiagramsForTheme = () => {
		if (themeRerenderFrame) return;

		themeRerenderFrame = window.requestAnimationFrame(() => {
			themeRerenderFrame = 0;

			const diagrams = Array.from(
				document.querySelectorAll<HTMLElement>(
					".mermaid-diagram[data-mermaid-loaded='true']",
				),
			);
			if (!diagrams.length) return;

			diagrams.forEach(resetRenderedDiagram);
			window.initMermaidDiagrams?.(document);
		});
	};

	window.initMermaidDiagrams = async (root = document) => {
		const diagrams = Array.from(
			root.querySelectorAll<HTMLElement>(
				".mermaid-diagram[data-mermaid-pending='true']:not([data-mermaid-rendering='true'])",
			),
		);

		if (!diagrams.length) return;

		diagrams.forEach((diagram) => {
			diagram.dataset.mermaidRendering = "true";
		});

		try {
			const { default: mermaid } = await getMermaid();
			applyMermaidTheme(mermaid);

			await Promise.all(
				diagrams.map(async (diagram, index) => {
					try {
						const source = diagram.querySelector<HTMLElement>(".mermaid-source");
						const placeholder =
							diagram.querySelector<HTMLElement>(".mermaid-placeholder");
						const definition = source?.textContent?.trim();

						if (!definition) {
							throw new Error("Mermaid definition is empty.");
						}

						const parseResult = await mermaid.parse(definition, {
							suppressErrors: true,
						});
						if (parseResult === false) {
							throw new Error("Mermaid definition is invalid.");
						}

						const id = `mermaid-${Date.now()}-${index}`;
						const { svg, bindFunctions } = await mermaid.render(id, definition);
						const renderTarget = document.createElement("div");
						renderTarget.className = "mermaid-render";
						renderTarget.innerHTML = svg;

						placeholder?.replaceWith(renderTarget);
						bindFunctions?.(renderTarget);
						diagram.dataset.mermaidPending = "false";
						diagram.dataset.mermaidLoaded = "true";
					} catch (error) {
						showDiagramError(diagram, error);
					}
				}),
			);
		} catch (error) {
			diagrams.forEach((diagram) => {
				showDiagramError(diagram, error);
			});
		} finally {
			diagrams.forEach((diagram) => {
				delete diagram.dataset.mermaidRendering;
			});
		}
	};

	const initPageMermaid = () => {
		schedule(() => {
			window.initMermaidDiagrams?.(document);
		});
	};

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initPageMermaid, {
			once: true,
		});
	} else {
		initPageMermaid();
	}

	document.addEventListener("astro:page-load", initPageMermaid);
	document.addEventListener("encrypted-post-unlocked", (event) => {
		const root = (event as CustomEvent<{ root?: ParentNode }>).detail?.root;
		schedule(() => {
			window.initMermaidDiagrams?.(root ?? document);
		});
	});

	new MutationObserver((mutations) => {
		if (
			mutations.some(
				(mutation) =>
					mutation.type === "attributes" && mutation.attributeName === "class",
			)
		) {
			rerenderLoadedDiagramsForTheme();
		}
	}).observe(document.documentElement, {
		attributeFilter: ["class"],
		attributes: true,
	});
})();
</script>
