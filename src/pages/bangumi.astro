---
import { getBangumiPageData } from "@utils/bangumi-data";
import { url } from "@utils/url-utils";
import BangumiClient from "@/components/bangumi/BangumiClient.astro";
import BangumiSection from "@/components/bangumi/BangumiSection.astro";
import TabNav from "@/components/bangumi/TabNav.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const bangumiPageData = await getBangumiPageData();
const { activeTab, dataUpdatedAtText, itemsPerPage, sections, tabs } =
	bangumiPageData;
---

<MainGridLayout title={"Bangumi"} description={"Bangumi Collection"}>
  <link slot="head" rel="preconnect" href="https://lain.bgm.tv" />
  <link slot="head" rel="preconnect" href="https://bgm-img.xhwen.top" />

  <div
    class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
    data-bangumi-root
    data-active-section={activeTab}
    data-bangumi-data-url={url("/bangumi/data.json")}
  >
    <div class="card-base z-10 px-4 sm:px-9 py-5 sm:py-6 relative w-full">
      <div class="text-center mb-6 sm:mb-8">
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2 sm:mb-3">
          Bangumi
        </h1>
        <p class="text-gray-600 dark:text-gray-400 mb-2">
          今天也要好好追番，好好打游戏
        </p>
        <p class="text-xs text-gray-500 dark:text-gray-500 space-x-2">
          <span>数据更新时间：{dataUpdatedAtText}</span>
          <span>·</span>
          <span>按发售日排序</span>
        </p>
      </div>

      {tabs.length > 0 ? (
        <>
          <TabNav tabs={tabs} activeTab={activeTab} />

          {tabs.map((tab) => {
            const section = sections[tab.id];
            const isActive = tab.id === activeTab;
            const initialItems = isActive
              ? section.items.slice(0, itemsPerPage)
              : [];

            return (
              <BangumiSection
                sectionId={tab.id}
                items={section.items}
                initialItems={initialItems}
                isActive={isActive}
                itemsPerPage={itemsPerPage}
                totalItems={section.items.length}
              />
            );
          })}

          <BangumiClient />
        </>
      ) : (
        <div class="text-center py-12">
          <h2 class="text-xl font-medium text-gray-600 dark:text-gray-400 mb-2">
            暂无数据
          </h2>
          <p class="text-gray-500 dark:text-gray-400 mb-4">
            可能的原因：用户名不存在、网络连接问题或 API 限制
          </p>
        </div>
      )}
    </div>
  </div>
</MainGridLayout>

<style is:global>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bangumi-card {
    content-visibility: auto;
    contain-intrinsic-size: 200px 300px;
  }
</style>
